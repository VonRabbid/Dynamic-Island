<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DynamicIsland.ViewModels"
        xmlns:converters="clr-namespace:DynamicIsland.Converters"
        mc:Ignorable="d"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="440"
        Height="180"
        Left="0"
        Top="0">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NotNullToVisibilityConverter" Invert="True" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Standard Button Style for Media and Dismiss Controls -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="17" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25252E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#353540"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Round Play/Pause Button Style -->
        <Style x:Key="PlayPauseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="playBorder" Background="{TemplateBinding Background}" Width="36" Height="36" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="playBorder" Property="Background" Value="#E2E2E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="playBorder" Property="Background" Value="#C4C4CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <!-- Floating Capsule Container -->
        <Border x:Name="IslandBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="130"
                Height="32"
                CornerRadius="16"
                Background="#0C0C0F"
                BorderBrush="#242429"
                BorderThickness="1"
                ClipToBounds="True"
                Cursor="Hand"
                MouseEnter="IslandBorder_MouseEnter"
                MouseLeave="IslandBorder_MouseLeave"
                MouseLeftButtonDown="IslandBorder_MouseLeftButtonDown">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- 1. ESTADO REPOSO (Idle) -->
                <Grid x:Name="IdleView" Opacity="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Sensor indicator dot -->
                        <Ellipse Width="8" Height="8" Fill="#1A1A22" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#00FF88" Opacity="0.4"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Dynamic Island"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#7B7B86"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 2. ESTADO MÚSICA COMPACTO (MusicPlaying) -->
                <Grid x:Name="MusicCompactView" Opacity="0" Visibility="Collapsed" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Album Art Thumbnail -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#1B1B20" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid>
                            <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Fill="#80808C" Stretch="Uniform" Width="12" Height="12"
                                  Visibility="{Binding Media.Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                            <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding Media.Thumbnail, Converter={StaticResource NotNullToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Title & Artist -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Media.Title}"
                                   Foreground="#FFFFFF"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="16" />
                        <TextBlock Text="{Binding Media.Artist}"
                                   Foreground="#8E8E98"
                                   FontSize="9.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="14" />
                    </StackPanel>

                    <!-- Equalizer Visualizer Bars -->
                    <StackPanel Grid.Column="2" x:Name="EqualizerContainer" Orientation="Horizontal" VerticalAlignment="Center" Height="18" Margin="4,0,2,0">
                        <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="#1ED760" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Bar2" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="#1ED760" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Bar3" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="#1ED760" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Bar4" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="#1ED760" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>

                <!-- 3. ESTADO EXPANDIDO (Expanded) -->
                <Grid x:Name="ExpandedView" Opacity="0" Visibility="Collapsed" Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Track Header (Large Thumbnail + Details) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art -->
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="#1B1B20" ClipToBounds="True" Margin="0,0,12,0">
                            <Grid>
                                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                      Fill="#60606C" Stretch="Uniform" Width="22" Height="22"
                                      Visibility="{Binding Media.Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                                <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill"
                                       Visibility="{Binding Media.Thumbnail, Converter={StaticResource NotNullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Titles -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Media.Title}"
                                       Foreground="#FFFFFF"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Media.Artist}"
                                       Foreground="#9E9EA8"
                                       FontSize="11.5"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Controls Row -->
                    <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Previous Track Button -->
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Command="{Binding PreviousCommand}"
                                    Click="MediaButton_Click"
                                    ToolTip="Anterior"
                                    Width="34" Height="34">
                                <Path Data="M6 6h2v12H6zm3.5 6 8.5 6V6z"
                                      Fill="#D0D0D8" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>

                            <!-- Play / Pause Button -->
                            <Button Style="{StaticResource PlayPauseButtonStyle}"
                                    Command="{Binding PlayPauseCommand}"
                                    Click="MediaButton_Click"
                                    ToolTip="Reproducir / Pausar"
                                    Margin="18,0">
                                <Grid Width="16" Height="16">
                                    <Path Data="M8 5v14l11-7z"
                                          Fill="#000000"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                          Fill="#000000"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>

                            <!-- Next Track Button -->
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Command="{Binding NextCommand}"
                                    Click="MediaButton_Click"
                                    ToolTip="Siguiente"
                                    Width="34" Height="34">
                                <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"
                                      Fill="#D0D0D8" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 4. ESTADO NOTIFICACIÓN (Notification) -->
                <Grid x:Name="NotificationView" Opacity="0" Visibility="Collapsed" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Badge -->
                    <Border Grid.Column="0"
                            Background="#182436"
                            BorderBrush="#253A5A"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="8,3.5"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                                  Fill="#38BDF8"
                                  Stretch="Uniform"
                                  Width="11"
                                  Height="11"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentNotification.AppName}"
                                       Foreground="#38BDF8"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       MaxHeight="15"/>
                        </StackPanel>
                    </Border>

                    <!-- Notification Title & Body -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding CurrentNotification.Title}"
                                   Foreground="#FFFFFF"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="16" />
                        <TextBlock Text="{Binding CurrentNotification.Message}"
                                   Foreground="#9EABB8"
                                   FontSize="9.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="14" />
                    </StackPanel>

                    <!-- Dismiss Action Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MediaButtonStyle}"
                            Command="{Binding DismissNotificationCommand}"
                            Click="MediaButton_Click"
                            ToolTip="Descartar"
                            Width="22" Height="22" Margin="4,0,2,0">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Fill="#64748B"
                              Stretch="Uniform"
                              Width="9"
                              Height="9" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
