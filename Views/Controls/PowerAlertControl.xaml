<UserControl x:Class="DynamicIsland.Views.Controls.PowerAlertControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Margin="10,0"
             ClipToBounds="True">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="22" Height="22" CornerRadius="11" Background="#14281E" BorderBrush="#1E462E" BorderThickness="1" Margin="0,0,8,0">
            <Path Data="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-6 10.49z"
                  Fill="#22C55E"
                  Stretch="Uniform"
                  Width="12" Height="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding CurrentPowerAlert.Message}"
                   Foreground="#FFFFFF"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
