<UserControl x:Class="DynamicIsland.Views.Controls.CapsLockAlertControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Margin="8,0"
             ClipToBounds="True">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="20" Height="20" CornerRadius="5" Background="#242432" BorderBrush="#3B3B4E" BorderThickness="1" Margin="0,0,8,0">
            <TextBlock Text="A"
                       Foreground="#FFFFFF"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <TextBlock VerticalAlignment="Center"
                   FontSize="10.5"
                   FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Mayús desactivado"/>
                    <Setter Property="Foreground" Value="#8E8E98"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCapsLockOn}" Value="True">
                            <Setter Property="Text" Value="MAYÚS ACTIVADO"/>
                            <Setter Property="Foreground" Value="#22C55E"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
