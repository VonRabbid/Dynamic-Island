<UserControl x:Class="DynamicIsland.Views.Controls.IdleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             ClipToBounds="True">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Sensor indicator dot -->
        <Ellipse Width="8" Height="8" Fill="#1A1A22" Margin="0,0,8,0">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#00FF88" Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="Dynamic Island"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#7B7B86"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
